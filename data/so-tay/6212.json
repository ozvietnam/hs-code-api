      "ngoaiTru": [],
      "nguon": "nhom6212.nhom",
      "trich": "Nhóm này cũng bao gồm các sản phẩm dệt kim hoặc móc và các chi tiết của nó được tạo hình trực tiếp do tăng hoặc giảm số hoặc kích cỡ mũi khâu và dùng để sản xuất các sản phẩm thuộc nhóm này",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "corset và đai làm hoàn toàn bằng cao su",
      "sangNhom": "4015",
      "nguon": "nhom6212.nhom",
      "trich": "The heading does not include corsets and belts made wholly of rubber (heading 40.15).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "dụng cụ chỉnh hình, đai thắt phẫu thuật, băng giữ hoặc loại tương tự",
      "sangNhom": "9021",
      "nguon": "ch62.chuong",
      "trich": "Dụng cụ chỉnh hình, đai thắt phẫu thuật, băng giữ hoặc loại tương tự (nhóm 90.21)",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "quần áo hoặc hàng may mặc đã qua sử dụng khác",
      "sangNhom": "6309",
      "nguon": "ch62.chuong",
      "trich": "Quần áo hoặc hàng may mặc đã qua sử dụng khác thuộc nhóm 63.09",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "quần áo và hàng may mặc phụ trợ thuộc các nhóm 39.26, 40.15, 42.03 hoặc 68.12",
      "sangNhom": "3926|4015|4203|6812",
      "nguon": "ch62.chuong",
      "trich": "Các loại quần áo và hàng may mặc phụ trợ thuộc các nhóm 39.26, 40.15,42.03 hoặc 68.12",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "miếng vải dệt đã qua một vài công đoạn gia công (như làm viền hoặc tạo đường viền cổ áo) dùng để sản xuất áo quần nhưng chưa được hoàn thiện đầy đủ",
      "sangNhom": "6307",
      "nguon": "ch62.chuong",
      "trich": "Các miếng vải dệt đã qua một vài công đoạn gia công (như làm viền hoặc tạo đường viền cổ áo) dùng để sản xuất áo quần nhưng chưa được hoàn thiện đầy đủ và được xem như quần áo hoặc các chi tiết của quần áo (nhóm 63.07)",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "hàng hóa thoạt nhìn có thể vừa xếp được vào nhóm 62.09 vừa xếp được vào các nhóm khác của Chương 62 (ưu tiên nhóm 62.09)",
      "sangNhom": "6209",
      "nguon": "ch62.chuong",
      "trich": "Những hàng hóa mà, thoạt nhìn, có thể vừa xếp được vào nhóm 62.09 vừa có thể xếp được vào các nhóm khác của Chương này, phải được xếp vào nhóm 62.09",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
