   "nguon": "nhom1604.nhom",
   "trich": "(e) Súp và nước xuýt và chế phẩm để làm súp và nước xuýt và các chế phẩm thực phẩm tổng hợp đồng nhất (nhóm 21.04).",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
 "loaiTru": [
  {
   "dieuKien": "Cá hun khói đã chín, chưa chế biến bằng cách nào khác",
   "sangNhom": "0305",
   "nguon": "nhom1604.nhom",
   "trich": "cá hun khói đã được làm chín trước hoặc trong quá trình hun khói vẫn được phân loại trong nhóm 03.05 miễn là nó chưa được chế biến bằng bất cứ một cách nào khác.",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Sản phẩm chiết xuất và nước ép từ cá",
   "sangNhom": "1603",
   "nguon": "nhom1604.nhom",
   "trich": "(b) Sản phẩm chiết xuất và nước ép từ cá (nhóm 16.03).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Cá được nhồi trong sản phẩm từ bộ nhào (pasta)",
   "sangNhom": "1902",
   "nguon": "nhom1604.nhom",
   "trich": "(c) Cá được nhồi trong sản phẩm từ bộ nhào (pasta) (nhóm 19.02).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Nước xốt, đồ gia vị hỗn hợp và bột canh hỗn hợp",
   "sangNhom": "2103",
   "nguon": "nhom1604.nhom",
   "trich": "(d) Nước xốt và các chế phẩm làm nước xốt, đồ gia vị hỗn hợp và bột canh hỗn hợp (nhóm 21.03).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Súp, nước xuýt và chế phẩm thực phẩm tổng hợp đồng nhất",
   "sangNhom": "2104",
   "nguon": "nhom1604.nhom",
   "trich": "(e) Súp và nước xuýt và chế phẩm để làm súp và nước xuýt và các chế phẩm thực phẩm tổng hợp đồng nhất (nhóm 21.04).",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
