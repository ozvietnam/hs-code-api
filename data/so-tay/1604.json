{
 "nhom": "1604",
 "phamVi": {
  "text": "Cá đã chế biến hoặc bảo quản (luộc, hấp, nướng, chiên, quay; trong dầu, dấm; bằng phương pháp khác); chế phẩm thực phẩm có chứa cá; trứng cá tầm muối và sản phẩm thay thế trứng cá tầm muối.",
  "nguon": "nhom1604.nhom",
  "trich": "Cá được luộc, hấp, nướng, chiên, quay hoặc làm chín bằng các cách khác…Cá được chế biến hoặc bảo quản trong dầu, dấm…Cá, và các bộ phận của cá, đã chế biến hoặc bảo quản bằng các phương pháp khác…Một số chế phẩm thực phẩm có chứa cá…Trứng cá tầm muối.",
  "nguonLoai": "AI_DA_KIEM"
 },
 "dieuKienVao": [
