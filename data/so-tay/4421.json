{
  "nhom": "4421",
  "phamVi": {
    "text": "Mọi mặt hàng bằng gỗ được sản xuất bằng cách tiện hay bất cứ cách khác, hoặc làm bằng gỗ khảm hay dát — trừ mặt hàng đã được chi tiết hoặc ghi ở các nhóm trước, và trừ mặt hàng được phân loại nơi khác không tính đến chất liệu cấu tạo; kèm các bộ phận bằng gỗ của những mặt hàng đã được chi tiết hoặc ghi ở các nhóm trước, trừ các mặt hàng thuộc nhóm 44.16.",
    "nguon": "nhom4421.nhom",
    "trich": "Nhóm này bao gồm tất cả các mặt hàng bằng gỗ được sản xuất bằng cách tiện hay bất cứ các cách khác, hoặc được làm bằng gỗ khảm hay dát, trừ những mặt hàng được chi tiết hoặc ghi ở các nhóm trước và trừ những mặt hàng được phân loại nơi khác không tính đến chất liệu cấu tạo của chúng (xem, ví dụ, Chú giải 1 của Chương này).\n\nNhóm này cũng bao gồm các bộ phận bằng gỗ của các mặt hàng được chi tiết hoặc ghi ở các nhóm trước, trừ các mặt hàng thuộc nhóm 44.16.",
    "nguonLoai": "NGUOI_DUYET"
  },
  "dieuKienVao": [],
  "loaiTru": [
    {
      "dieuKien": "Các dải gỗ dùng làm que diêm",
      "sangNhom": "4404",
      "nguon": "nhom4421.nhom",
      "trich": "(a) Các dải gỗ dùng làm que diêm (nhóm 44.04).",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Móc giày chưa hoàn thiện dưới dạng dải gỗ, có một rìa được gọt xiên trên cả hai mặt, sẵn sàng cho việc cắt tạo thành chốt",
      "sangNhom": "4409",
      "nguon": "nhom4421.nhom",
      "trich": "(b) Móc giày chưa hoàn thiện dưới dạng dải gỗ, có một rìa được gọt xiên trên cả hai mặt, sẵn sàng cho việc cắt tạo thành chốt (nhóm 44.09).",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Cán gỗ cho dao (trừ dao ăn) và các công cụ hoặc dụng cụ khác",
      "sangNhom": "4417",
      "nguon": "nhom4421.nhom",
      "trich": "(c) Cán gỗ, cho dao (trừ dao ăn) và các công cụ hoặc dụng cụ khác, thuộc nhóm 44.17.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Gỗ được tạo khuôn bằng cách chồng lên vật đúc trên một miếng gỗ khác đã được tạo khuôn hoặc chưa tạo khuôn, nhưng thuộc nhóm 44.18 — mục (10) nằm trong danh sách \"Nhóm này bao gồm\" và chỉ nêu ngoại lệ này.",
      "sangNhom": "4418",
      "nguon": "nhom4421.nhom",
      "trich": "(10) Gỗ được tạo khuôn bằng cách chồng lên vật đúc trên một miếng gỗ khác đã được tạo khuôn hoặc chưa tạo khuôn (trừ các loại thuộc nhóm 44.18).",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Súng và các bộ phận của súng",
      "sangNhom": "9305",
      "nguon": "nhom4421.nhom",
      "trich": "(k) Súng và các bộ phận của súng (nhóm 93.05).",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
