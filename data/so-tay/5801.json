{
 "nhom": "5801",
 "phamVi": {
  "text": "Các loại vải dệt nổi vòng và vải sơnin, trừ các loại vải thuộc nhóm 58.02 hoặc 58.06",
  "nguon": "nhom5801.nhom",
  "trich": "Các loại vải dệt nổi vòng được tạo thành từ ít nhất 3 loại sợi: sợi dọc và ngang kết hợp chặt chẽ tạo thành vải nền và sợi dọc hoặc sợi ngang tạo thành nổi vòng (pile).",
  "nguonLoai": "AI_DA_KIEM"
 },
 "dieuKienVao": [],
 "loaiTru": [
  {
   "dieuKien": "Vải giả da thú được làm bằng cách may hoặc dán bằng keo trên nhung",
   "sangNhom": "4304",
   "nguon": "nhom5801.nhom",
   "trich": "vải giả da thú được làm bằng cách may hoặc dán bằng keo trên nhung thì bị loại trừ (nhóm 43.04).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Vải khăn lông và các loại vải dệt thoi tạo vòng lông tương tự và các loại vải dệt chần sợi nổi vòng",
   "sangNhom": "5802",
   "nguon": "nhom5801.nhom",
   "trich": "(b) Vải khăn lông và các loại vải dệt thoi tạo vòng lông tương tự và các loại vải dệt chần sợi nổi vòng (thuộc nhóm 58.02).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Các loại vải tuyết nhung nằm trong định nghĩa vải dệt thoi khổ hẹp",
   "sangNhom": "5806",
   "nguon": "nhom5801.nhom",
   "trich": "(c) Các loại vải tuyết nhung (pile)..., các loại vải nằm trong định nghĩa vải dệt thoi khổ hẹp (nhóm 58.06).",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
 "phanBiet": [
  {
   "hoi": "Hàng có phải là vải giả da thú may hoặc dán keo trên nhung chuyển sang nhóm 43.04 không?",
   "neuCo": "4304",
   "neuKhong": "5801",
   "nguon": "nhom5801.nhom",
   "trich": "vải giả da thú được làm bằng cách may hoặc dán bằng keo trên nhung thì bị loại trừ (nhóm 43.04).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "hoi": "Hàng có phải là vải khăn lông hoặc vải dệt chần sợi nổi vòng chuyển sang nhóm 58.02 không?",
   "neuCo": "5802",
   "neuKhong": "5801",
   "nguon": "nhom5801.nhom",
   "trich": "(b) Vải khăn lông và các loại vải dệt thoi tạo vòng lông tương tự và các loại vải dệt chần sợi nổi vòng (thuộc nhóm 58.02).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "hoi": "Hàng có phải là vải dệt thoi khổ hẹp chuyển sang nhóm 58.06 không?",
   "neuCo": "5806",
   "neuKhong": "5801",
   "nguon": "nhom5801.nhom",
   "trich": "(c) Các loại vải tuyết nhung (pile)..., các loại vải nằm trong định nghĩa vải dệt thoi khổ hẹp (nhóm 58.06).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "hoi": "Hàng có phải là vải dệt kim với lớp nhung nổi vòng chuyển sang nhóm 60.01 không?",
   "neuCo": "6001",
   "neuKhong": "5801",
