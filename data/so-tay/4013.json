      "donVi": null,
      "ngoaiTru": [
        "sản phẩm bị loại trừ theo Chú giải 2 của Chương 40"
      ],
      "nguon": "ch40.chuong",
      "trich": "Chương này bao gồm cao su, như đã định nghĩa ở trên, ở dạng nguyên liệu thô hay bán thành phẩm, … và các sản phẩm làm toàn bộ từ cao su hoặc có đặc tính cơ bản của hàng hoá dẫn xuất từ cao su, trừ những sản phẩm bị loại trừ theo Chú giải 2 của Chương này.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "fact": "cao_su_da_luu_hoa",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [
        "cao su cứng"
      ],
      "nguon": "ch40.chuong",
      "trich": "(e) Các nhóm từ nhóm 40.07 đến nhóm 40.16 bao gồm các bán thành phẩm và các sản phẩm của cao su đã lưu hoá, trừ cao su cứng.",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "Săm lốp máy xúc lật ở dạng miếng vá săm, vòng đệm, miếng đệm, tấm lót hoặc các mặt hàng khác bằng cao su lưu hóa (trừ cao su cứng, không phải săm lắp vào lốp xe hoặc máy xúc lật)",
      "sangNhom": "4016",
      "nguon": "ch40.chuong",
      "trich": "(f) Sản phẩm thuộc Chương 95 (trừ găng tay thể thao, găng hở ngón và găng tay bao và các sản phẩm thuộc các nhóm từ 40.11 đến 40.13).",
      "canCuLoaiTru": {
        "nguon": "nhom4016.nhom",
        "trich": "Nhóm này bao gồm tất cả các mặt hàng bằng cao su lưu hoá (trừ cao su cứng) không nằm trong các nhóm trước của Chương này hoặc các Chương khác."
      },
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
