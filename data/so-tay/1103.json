{
 "nhom": "1103",
 "phamVi": {
  "text": "Ngũ cốc dạng tấm, dạng bột thô và dạng viên; không gồm phế liệu được viên lại từ quá trình xay xát ngũ cốc (Chương 23).",
  "nguon": "nhom1103.nhom",
  "trich": "Ngũ cốc dạng tấm là những mảnh vỡ nhỏ hoặc lõi chứa bột của hạt ngũ cốc từ quá trình xay thô ngũ cốc.…Bột thô là sản phẩm có hình hạt hơn so với bột mịn và được tạo ra từ quá trình sàng đầu tiên sau xay xát, hoặc nghiền lại và sàng lại tấm từ quá trình xay xát đầu tiên.…Viên là những sản phẩm thu được từ quá trình xay xát các loại ngũ cốc thuộc Chương này được tích tụ bằng cách nén trực tiếp bằng áp lực hay bổ sung chất kết dính với tỉ lệ không quá 3% trọng lượng…Nhóm này không bao gồm những phế liệu được viên lại từ quá trình xay xát ngũ cốc (Chương 23).",
  "nguonLoai": "NGUOI_DUYET"
 },
 "dieuKienVao": [
  {
   "fact": "ty_le_chat_ket_dinh_trong_vien",
   "op": "<=",
   "value": 3,
   "donVi": "%",
   "ngoaiTru": [],
   "nguon": "nhom1103.nhom",
   "trich": "Viên là những sản phẩm thu được từ quá trình xay xát các loại ngũ cốc thuộc Chương này được tích tụ bằng cách nén trực tiếp bằng áp lực hay bổ sung chất kết dính với tỉ lệ không quá 3% trọng lượng (xem Chú giải 1 của Phần II).",
   "nguonLoai": "NGUOI_DUYET"
  }
 ],
 "loaiTru": [],
 "phanBiet": [
  {
   "hoi": "Sản phẩm có tỷ lệ phần trăm lọt qua sàng không thấp hơn tỷ lệ ghi cho từng loại ngũ cốc không?",
   "neuCo": "1101|1102",
   "neuKhong": "1103|1104",
   "nguon": "ch11.chuong",
   "trich": "Các sản phẩm thuộc Chương này theo những quy định trên đây sẽ được xếp vào nhóm 11.01 hoặc 11.02 nếu có tỷ lệ phần trăm lọt qua sàng bằng lưới kim loại với kích thước mắt sàng ghi trong Cột (4) hoặc (5) không thấp hơn tỷ lệ ghi cho từng loại ngũ cốc, tính theo trọng lượng.…Các trường hợp khác sẽ được xếp vào nhóm 11.03 hoặc 11.04.",
   "nguonLoai": "NGUOI_DUYET"
