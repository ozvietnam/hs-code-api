{
  "nhom": "8511",
  "phamVi": {
    "text": "Thiết bị khởi động điện hoặc đánh lửa điện và thiết bị dùng cho động cơ đốt trong (piston hoặc loại khác); gồm cả máy phát và máy cắt điện dùng kết hợp với động cơ đốt trong.",
    "nguon": "nhom8511.nhom",
    "trich": "Nhóm này bao gồm các thiết bị khởi động điện hoặc thiết bị đánh lửa điện và các thiết bị dùng cho các loại động cơ đốt trong (piston hoặc các loại khác)… Nó cũng bao gồm các máy phát và máy cắt điện được sử dụng kết hợp với các động cơ đốt trong.",
    "nguonLoai": "AI_DA_KIEM"
  },
  "dieuKienVao": [
    {
      "fact": "dung_cho_dong_co_dot_trong",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "nhom8511.nhom",
      "trich": "Nhóm này bao gồm các thiết bị khởi động điện hoặc thiết bị đánh lửa điện và các thiết bị dùng cho các loại động cơ đốt trong (piston hoặc các loại khác), hoặc được sử dụng cho động cơ ô tô, phương tiện bay, tàu thủy, hoặc các dạng tương tự, hoặc các động cơ tĩnh.",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "Thiết bị khởi động động cơ dùng trong sân bay, trạm xe buýt... để khởi động động cơ đốt trong và bao gồm chủ yếu là máy biến thế và bộ chỉnh lưu",
      "sangNhom": "8504",
      "nguon": "nhom8511.nhom",
      "trich": "Nhóm này không bao gồm: (a) Các khởi động động cơ sử dụng trong sân bay, trạm xe buýt..., để khởi động động cơ đốt trong và bao gồm chủ yếu là máy biến thế và bộ chỉnh lưu (nhóm 85.04).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Ắc qui điện",
      "sangNhom": "8507",
      "nguon": "nhom8511.nhom",
      "trich": "Nhóm này không bao gồm: … (b) Các ắc qui điện (nhóm 85.07).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Dynamo cho xe đạp, chỉ dùng để chiếu sáng",
      "sangNhom": "8512",
      "nguon": "nhom8511.nhom",
      "trich": "Nhóm này không bao gồm: … (c) Các dynamo cho xe đạp, chỉ dùng để chiếu sáng (nhóm 85.12).",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
