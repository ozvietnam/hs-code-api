{
  "nhom": "0308",
  "phamVi": {
    "text": "Động vật thủy sinh không xương sống trừ động vật giáp xác và động vật thân mềm: sống, tươi, ướp lạnh, đông lạnh, làm khô, muối, ngâm nước muối; hoặc hun khói, đã hoặc chưa làm chín trước hoặc trong quá trình hun khói.",
    "nguon": "nhom0308.nhom",
    "trich": "Động vật thủy sinh không xương sống trừ động vật giáp xác và động vật thân mềm, sống, tươi, ướp lạnh, đông lạnh, làm khô, muối hoặc ngâm nước muối. … Động vật thủy sinh không xương sống hun khói trừ động vật giáp xác và động vật thân mềm, đã hoặc chưa làm chín trước hoặc trong quá trình hun khói.",
    "nguonLoai": "NGUOI_DUYET"
  },
  "dieuKienVao": [
    {
      "fact": "khong_phai_dong_vat_giap_xac_hoac_dong_vat_than_mem",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "nhom0308.nhom",
      "trich": "(1) Động vật thủy sinh không xương sống trừ động vật giáp xác và động vật thân mềm … (2) Động vật thủy sinh không xương sống hun khói trừ động vật giáp xác và động vật thân mềm",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "Động vật thủy sinh không xương sống được chế biến hay bảo quản theo những cách không được nêu trong nhóm này (ví dụ được luộc trong nước hoặc bảo quản trong dấm)",
      "sangNhom": "1605",
      "nguon": "nhom0308.nhom",
      "trich": "Nhóm này không bao gồm các động vật thủy sinh không xương sống được chế biến hay bảo quản theo những cách không được nêu trong nhóm này (ví dụ động vật thủy sinh không xương sống được luộc trong nước hoặc bảo quản trong dấm) (nhóm 16.05).",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
  "phanBiet": [
    {
      "hoi": "Hàng đã được luộc trong nước hoặc bảo quản trong dấm, tức là chế biến hoặc bảo quản theo cách khác với những cách nêu trong nhóm này?",
      "neuCo": "1605",
