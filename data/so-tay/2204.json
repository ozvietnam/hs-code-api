{
  "nhom": "2204",
  "phamVi": {
    "text": "Rượu vang thông thường, rượu vang được làm cao độ với cồn, rượu vang nổ, rượu vang ngọt tráng miệng; và hèm nho.",
    "nguon": "nhom2204.nhom",
    "trich": "(1) Rượu vang thông thường (vang đỏ, hồng hoặc trắng).…(2) Rượu vang được làm cao độ với cồn.…(3) Rượu vang nổ.…(4) Các loại rượu vang ngọt tráng miệng (đôi khi được gọi là rượu vang mùi).…(II) Hèm nho",
    "nguonLoai": "NGUOI_DUYET"
  },
  "dieuKienVao": [],
  "loaiTru": [
    {
      "dieuKien": "Đồ uống có thành phần cơ bản là rượu vang",
      "sangNhom": "2205",
      "nguon": "nhom2204.nhom",
      "trich": "(a) Các loại đồ uống có thành phần cơ bản là rượu vang thuộc nhóm 22.05.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Dược phẩm thuộc nhóm 30.03 hoặc 30.04",
      "sangNhom": "3003|3004",
      "nguon": "nhom2204.nhom",
      "trich": "(b) Dược phẩm thuộc nhóm 30.03 hoặc 30.04.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Nước ép nho, hèm nho chưa lên men hoặc cồn ≤ 0,5%",
      "sangNhom": "2009",
      "nguon": "nhom2204.nhom",
      "trich": "Nhóm này không bao gồm các loại nước ép nho và hèm nho, đã hoặc chưa cô đặc, chưa lên men hoặc có nồng độ cồn theo thể tích không quá 0,5% (nhóm 20.09).",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
  "phanBiet": [
    {
      "hoi": "Hàng có phải là nước ép nho hoặc hèm nho chưa lên men hoặc có nồng độ cồn không quá 0,5% không?",
