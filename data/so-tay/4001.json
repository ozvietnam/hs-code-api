   "nguon": "nhom4001.nhom",
   "trich": "Mủ cao su tự nhiên là chất lỏng được tiết ra chủ yếu từ cây cao su, và nhất là từ loài Hevea brasiliensis.",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
 "loaiTru": [
  {
   "dieuKien": "Hỗn hợp của bất kỳ sản phẩm nào thuộc nhóm 40.01 với sản phẩm thuộc nhóm 40.02",
   "sangNhom": "4002",
   "nguon": "nhom4001.nhom",
   "trich": "Nhóm này không bao gồm: … (a) Các hỗn hợp của bất kỳ sản phẩm nào thuộc nhóm này với bất kỳ sản phẩm nào thuộc nhóm 40.02 (nhóm 40.02).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Cao su tự nhiên pha trộn với các chất bị cấm theo Chú giải 5(A)",
   "sangNhom": "4005",
   "nguon": "nhom4001.nhom",
   "trich": "(b) Cao su tự nhiên, nhựa balata, nhựa két (gutta - percha), nhựa guayule, nhựa chicle và các loại nhựa tự nhiên tương tự, được pha trộn, trước hoặc sau khi đông tụ, với các chất bị cấm theo Chú giải 5 (A) Chương này (nhóm 40.05 hoặc 40.06).",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
 "phanBiet": [
  {
   "hoi": "Hàng hóa có phải là hỗn hợp của sản phẩm tự nhiên với cao su thuộc nhóm 40.02 không?",
   "neuCo": "4002",
   "neuKhong": "4001",
   "nguon": "nhom4001.nhom",
   "trich": "Nhóm này không bao gồm: … (a) Các hỗn hợp của bất kỳ sản phẩm nào thuộc nhóm này với bất kỳ sản phẩm nào thuộc nhóm 40.02 (nhóm 40.02).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "hoi": "Cao su có bị pha trộn với các chất cấm theo Chú giải 5(A) dẫn sang nhóm 40.05 hoặc 40.06 không?",
   "neuCo": "4005",
   "neuKhong": "4001",
