{
 "nhom": "2931",
 "phamVi": {
  "text": "Các hợp chất vô cơ - hữu cơ khác có chứa nguyên tử kim loại hoặc phi kim liên kết trực tiếp với nguyên tử carbon.",
  "nguon": "nhom2931.nhom",
  "trich": "Nhóm này bao gồm:\n\n(1) Chì tetrametyl (Pb(CH3)4) và chì tetraetyl (Pb(C2H5)4).",
  "nguonLoai": "AI_DA_KIEM"
 },
 "dieuKienVao": [
  {
   "fact": "la_hop_chat_vo_co_huu_co",
   "op": "=",
   "value": true,
   "donVi": null,
   "ngoaiTru": [],
   "nguon": "ch29.chuong",
   "trich": "Các hợp chất của các nhóm 29.30 và 29.31 là các hợp chất hữu cơ mà trong đó các phân tử chứa, ngoài các nguyên tử hydro, oxy hoặc niter, còn có chứa các nguyên tử của các phi kim loại khác hoặc của kim loại (như lưu huỳnh, arson hoặc chì) liên kết trực tiếp với các nguyên tử carbon.",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
 "loaiTru": [
  {
   "dieuKien": "Este của axit silicic và muối của chúng",
   "sangNhom": "2920",
   "nguon": "nhom2931.nhom",
   "trich": "Este của axit silicic và muối của chúng được phân loại vào nhóm 29.20.",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Các hợp chất silicon của nhóm 39.10",
   "sangNhom": "3910",
   "nguon": "nhom2931.nhom",
   "trich": "Đó là các silicon của nhóm 39.10.",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Các hợp chất lưu huỳnh-hữu cơ mà phân tử có các nguyên tử phi kim hoặc kim loại khác liên kết trực tiếp với các nguyên tử cacbon",
   "sangNhom": "2930",
   "nguon": "nhom2931.nhom",
   "trich": "Nó loại trừ các hợp chất mà phân tử của chúng có chứa, ngoài các nguyên tử lưu huỳnh liên kết trực tiếp với các nguyên tử cacbon, các hợp chất mà phân tử có các nguyên tử phi kim hoặc kim loại khác liên kết trực tiếp với các nguyên tử cacbon (Ví dụ, fonofos (ISO)) (nhóm 29.30).",
   "nguonLoai": "AI_DA_KIEM"
  },
  {
   "dieuKien": "Các hợp chất thủy ngân-hữu cơ",
   "sangNhom": "2852",
   "nguon": "nhom2931.nhom",
   "trich": "Nhóm này cũng loại trừ các hợp chất thủy ngân-hữu cơ chứa một hoặc nhiều hơn một nguyên tử thủy ngân, đặc biệt nhóm (-HgX) trong đó X là phần còn lại của axit hữu cơ hoặc vô cơ (nhóm 28.52).",
   "nguonLoai": "AI_DA_KIEM"
  }
 ],
