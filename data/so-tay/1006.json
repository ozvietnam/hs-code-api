  "tieuChi6": [
    {
      "hs6": "100610",
      "fact": "con_nguyen_vo_thoc",
      "op": "=",
      "value": true,
      "donVi": null,
      "nguon": "nhom1006.nhom",
      "trich": "(1) Gạo còn nguyên vỏ (thóc hay thóc chưa xay), tức là, gạo còn nguyên vỏ trấu bao chặt lấy hạt.",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "hs6": "100620",
      "fact": "gao_lut_van_con_vo_lua",
      "op": "=",
      "value": true,
      "donVi": null,
      "nguon": "nhom1006.nhom",
      "trich": "(2) Gạo lứt (gạo mới xay bỏ phần trấu), mặc dù đã được xay bỏ hết phần trấu bởi máy xay, nhưng vẫn còn phần vỏ lụa.",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "hs6": "100630",
      "fact": "da_xat_so_bo_hoac_da_xat_toan_bo",
      "op": "=",
      "value": true,
      "donVi": null,
      "nguon": "nhom1006.nhom",
      "trich": "(3) Gạo đã xát sơ bộ, tức là, gạo còn nguyên hạt nhưng một phần vỏ lụa đã bị tách.…(4) Gạo đã xát toàn bộ (gạo đã tẩy trắng), gạo nguyên hạt đã được xát hết phần vỏ lụa bằng máy xát (hình phễu).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "hs6": "100630",
      "fact": "duoc_phu_mot_lop_dau_mong",
      "op": "=",
      "value": true,
      "donVi": null,
      "nguon": "nhom1006.nhom",
      "trich": "Nhóm này cũng bao gồm loại gạo \"làm bóng bằng dầu (Camolino)\" là loại gạo đã xát trắng được phủ một lớp dầu mỏng.",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "hs6": "100630",
      "fact": "la_gao_giau_vitamin",
      "op": "=",
      "value": true,
      "donVi": null,
      "nguon": "nhom1006.nhom",
      "trich": "(a) Gạo giàu vitamin, là hỗn hợp giữa loại gạo xát trắng thường và một lượng rất nhỏ (1%) hạt gạo đã được phủ hoặc tẩm các chất vitamin.",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "hs6": "100640",
      "fact": "la_gao_tam_bi_vos_trong_qua_trinh_che_bien",
      "op": "=",
      "value": true,
      "donVi": null,
      "nguon": "nhom1006.nhom",
      "trich": "(5) Gạo tấm, là loại gạo bị vỡ trong quá trình chế biến.",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
