{
  "nhom": "1006",
  "phamVi": {
    "text": "Gạo: gạo còn nguyên vỏ (thóc), gạo lứt, gạo đã xát sơ bộ, gạo đã xát toàn bộ, gạo tấm; cùng gạo giàu vitamin, gạo đồ và gạo làm bóng bằng dầu (Camolino).",
    "nguon": "nhom1006.nhom",
    "trich": "Nhóm này bao gồm:…(1) Gạo còn nguyên vỏ (thóc hay thóc chưa xay)…(2) Gạo lứt…(3) Gạo đã xát sơ bộ…(4) Gạo đã xát toàn bộ…(5) Gạo tấm…Nhóm này cũng bao gồm:…(a) Gạo giàu vitamin…(b) Gạo đồ…Nhóm này cũng bao gồm loại gạo \"làm bóng bằng dầu (Camolino)\"…",
    "nguonLoai": "NGUOI_DUYET"
  },
  "dieuKienVao": [
    {
      "fact": "khong_phai_gao_da_che_bien_thay_doi_dang_ke_cau_hat",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "nhom1006.nhom",
      "trich": "Những loại gạo khác mà cấu trúc hạt đã bị thay đổi đáng kể trong quá trình chế biến không được phân loại vào nhóm này.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "fact": "o_dang_hat",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "ch10.chuong",
      "trich": "1. (A) Các sản phẩm kể tên trong các nhóm của Chương này chỉ được phân loại trong các nhóm đó khi ở dạng hạt, còn hoặc không còn ở trên bông hay trên thân cây.",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "Gạo đã được nấu chín trước (một phần hay toàn phần) và sau đó được rút hết nước",
      "sangNhom": "1904",
      "nguon": "nhom1006.nhom",
      "trich": "Loại gạo đã được nấu chín trước là gạo đã được nấu chín một phần hay toàn phần và sau đó được rút hết nước thuộc vào nhóm 19.04.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "Bỏng gạo (puffed rice) có được sau quá trình nổ bỏng và ăn được ngay",
      "sangNhom": "1904",
      "nguon": "nhom1006.nhom",
      "trich": "Còn bỏng gạo (puffed rice) có được sau quá trình nổ bỏng và ăn được ngay cũng được phân loại vào nhóm 19.04.",
      "nguonLoai": "NGUOI_DUYET"
    }
  ],
  "phanBiet": [
    {
      "hoi": "Hàng là gạo đã được nấu chín trước (một phần hay toàn phần) và sau đó được rút hết nước?",
      "neuCo": "1904",
      "neuKhong": "1006",
      "nguon": "nhom1006.nhom",
      "trich": "Loại gạo đã được nấu chín trước là gạo đã được nấu chín một phần hay toàn phần và sau đó được rút hết nước thuộc vào nhóm 19.04.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "hoi": "Hàng là bỏng gạo (puffed rice)?",
      "neuCo": "1904",
