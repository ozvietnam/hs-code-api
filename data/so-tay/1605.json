{
 "nhom": "1605",
 "phamVi": {
  "text": "Động vật giáp xác và động vật thân mềm đã chế biến hoặc bảo quản; cầu gai, hải sâm và sứa. Không gồm giáp xác còn nguyên vỏ đã hấp chín, luộc chín trong nước và thân mềm trước khi vận chuyển, đông lạnh.",
  "nguon": "nhom1605.nhom",
  "trich": "Động vật giáp xác và động vật thân mềm được chế biến và bảo quản thông dụng nhất gồm cua, ghẹ, tôm prawn, tôm hùm, tôm (crawfish), tôm sông, vẹm, bạch tuộc, mực ống và ốc.",
  "nguonLoai": "AI_DA_KIEM"
 },
