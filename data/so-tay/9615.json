{
  "nhom": "9615",
  "phamVi": {
    "text": "Lược vệ sinh và lược chải tóc (kể cả lược chải cho động vật), trâm cài tóc và loại tương tự, kẹp tóc, kẹp/cặp/cuộn uốn tóc và loại tương tự (trừ loại thuộc nhóm 85.16).",
    "nguon": "nhom9615.nhom",
    "trich": "Lược vệ sinh các loại, kể cả lược chải cho động vật. … Lược chải tóc các loại … Trâm cài tóc và các loại tương tự … Kẹp tóc. … Kẹp uốn tóc, cặp uốn tóc, cuộn uốn tóc và các loại tương tự, trừ loại thuộc nhóm 85.16",
    "nguonLoai": "AI_DA_KIEM"
  },
  "dieuKienVao": [
    {
      "fact": "kim_loai_quy_hoac_da_quy_chi_la_thanh_phan_phu",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "ch96.chuong",
      "trich": "các nhóm từ 96.01 đến 96.06 và 96.15 kể cả các mặt hàng có chứa ngọc trai thiên nhiên hoặc nuôi cấy, đá quý hoặc đá bán quý … nhưng những chất liệu này chỉ là thành phần phụ.",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "fact": "ham_luong_kim_loai_quy_hoac_da_quy_qua_nho",
      "op": "=",
      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "nhom9615.nhom",
      "trich": "Những sản phẩm này xếp vào Chương 71 nếu chứa kim loại quí hoặc kim loại mạ kim loại quí, chứa ngọc trai tự nhiên hoặc nuôi cấy, đá quí hoặc bán quí (tự nhiên, tổng hợp hoặc tái tạo), trừ loại có hàm lượng các chất trên quá nhỏ.",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "Kẹp uốn tóc, cặp uốn tóc, cuộn uốn tóc và các loại tương tự thuộc nhóm 85.16",
      "sangNhom": "8516",
      "nguon": "nhom9615.nhom",
      "trich": "Kẹp uốn tóc, cặp uốn tóc, cuộn uốn tóc và các loại tương tự, trừ loại thuộc nhóm 85.16",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Đồ trang sức làm bằng chất liệu khác",
      "sangNhom": "7117",
      "nguon": "ch96.chuong",
      "trich": "Chương này không bao gồm: … (c) Đồ trang sức làm bằng chất liệu khác (nhóm 71.17);",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Dây buộc trang trí tóc, dây buộc tóc hoặc sản phẩm bằng plastic thông dụng chưa được chi tiết ở nơi khác (không phải lược, trâm cài tóc, kẹp tóc, cặp hoặc cuộn uốn tóc và loại tương tự để giữ tóc theo nếp hoặc trang điểm thuộc nhóm 96.15)",
      "sangNhom": "3926",
      "nguon": "nhom9615.nhom",
      "trich": "Nhóm này bao gồm: … (3) Trâm cài tóc và các loại tương tự để tóc theo nếp hoặc để trang điểm. … (4) Kẹp tóc. (5) Kẹp uốn tóc, cặp uốn tóc, cuộn uốn tóc và các loại tương tự, trừ loại thuộc nhóm 85.16 … Các sản phẩm này thường bằng kim loại cơ bản hoặc bằng plastic.",
      "canCuLoaiTru": {
        "nguon": "nhom3926.nhom",
        "trich": "Nhóm này bao gồm các sản phẩm, chưa được chi tiết hoặc ghi ở nơi khác, bằng plastic (như đã định nghĩa trong Chú giải 1 thuộc Chương này) hoặc bằng các vật liệu khác thuộc các nhóm từ 39.01 đến 39.14."
      },
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
