{
  "nhom": "3808",
  "phamVi": {
    "text": "Thuốc trừ côn trùng, thuốc diệt loài gặm nhấm, thuốc diệt nấm, thuốc diệt cỏ, thuốc chống nảy mầm và thuốc điều hòa sinh trưởng cây trồng, thuốc khử trùng và các sản phẩm tương tự.",
    "nguon": "nhom3808.nhom",
    "trich": "Nhóm này bao gồm một loạt các sản phẩm (trừ các sản phẩm mang đặc tính của dược phẩm, kể cả thuốc thú y- nhóm 30.03 hoặc 30.04) nhằm diệt trừ các vi trùng, các côn trùng gây bệnh (muỗi, nhậy, bọ hung vàng đen, gián,...), rêu và mốc, cỏ dại, loài gặm nhấm, chim rừng,...",
    "nguonLoai": "AI_DA_KIEM"
  },
  "dieuKienVao": [
    {
      "fact": "la_thuoc_diet_dich_hai_hoac_dieu_hoa_sinh_truong",
