{
  "nhom": "7320",
  "phamVi": {
    "text": "Lò xo các loại bằng sắt hoặc thép, không kể đến công dụng. Gồm các kiểu: (A) lò xo lá (một lá hoặc lá nhíp), (B) lò xo cuộn (gồm lò xo xoắn cuộn nén/kéo/xoắn, và lò xo xoắn ốc), (c) lò xo dẹt và xoắn ốc dẹt, (d) lò xo đĩa và lò xo vòng. Lò xo có thể lắp ráp với bu lông hình chữ U hoặc phụ kiện để lắp ráp/gắn. Các lá của lò xo cũng thuộc nhóm này.",
    "nguon": "nhom7320.nhom",
    "trich": "Nhóm này bao gồm lò xo các loại bằng sắt hoặc thép, không kể đến công dụng của chúng, trừ lò xo đồng hồ hoặc lò xo đồng hồ đeo tay thuộc nhóm 91.14. … (A) Lò xo lá (lò xo một lá hoặc lò xo lá nhíp) … (B) Lò xo cuộn … (1) Lò xo xoắn cuộn … (2) Lò xo xoắn ốc … (c) Lò xo dẹt và lò xo xoắn ốc dẹt … (d) Lò xo đĩa và lò xo vòng … Lò xo có thể được lắp ráp với bu lông hình chữ U (ví dụ đối với các lò xo lá) hoặc các phụ kiện để lắp ráp hoặc gắn. Các lá của lò xo cũng được phân loại trong nhóm này.",
    "nguonLoai": "NGUOI_DUYET"
  },
  "dieuKienVao": [],
  "loaiTru": [
    {
      "dieuKien": "lò xo đồng hồ hoặc lò xo đồng hồ đeo tay",
      "sangNhom": "9114",
      "nguon": "nhom7320.nhom",
      "trich": "Nhóm này bao gồm lò xo các loại bằng sắt hoặc thép, không kể đến công dụng của chúng, trừ lò xo đồng hồ hoặc lò xo đồng hồ đeo tay thuộc nhóm 91.14.",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "lò xo cho các trục hoặc cần của ô hoặc ô che nắng",
      "sangNhom": "6603",
      "nguon": "nhom7320.nhom",
      "trich": "(a) Lò xo cho các trục hoặc cần của ô hoặc ô che nắng (nhóm 66.03).",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "vòng đệm lò xo",
      "sangNhom": "7318",
      "nguon": "nhom7320.nhom",
      "trich": "(b) Vòng đệm lò xo (nhóm 73.18).",
      "nguonLoai": "NGUOI_DUYET"
    },
    {
      "dieuKien": "lò xo lắp ráp với các sản phẩm khác để tạo dáng (ví dụ: các cơ cấu đóng cửa tự động)",
      "sangNhom": "8302",
      "nguon": "nhom7320.nhom",
      "trich": "(c) Lò xo lắp ráp với các sản phẩm khác để tạo dáng, ví dụ các cơ cấu đóng cửa tự động (nhóm 83.02)",
      "nguonLoai": "NGUOI_DUYET"
    }
