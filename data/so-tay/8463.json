      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Máy bó kiện, máy đóng nắp đồ hộp",
      "sangNhom": "8422",
      "nguon": "nhom8463.nhom",
      "trich": "(b) Máy bó dùng để bó các kiện lại với nhau, máy đóng nắp đồ hộp hoặc đồ chứa khác (nhóm 84.22).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Trung tâm gia công, máy kết cấu nguyên khối và máy chuyển dịch đa vị trí",
      "sangNhom": "8457",
      "nguon": "nhom8463.nhom",
      "trich": "(c) Trung tâm gia công, máy kết cấu nguyên khối (một vị trí gia công) và máy gia công chuyển dịch đa vị trí, để gia công kim loại (nhóm 84.57).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Máy công cụ rèn, dập, dập nổi, ép, uốn cán thuộc nhóm 84.62",
      "sangNhom": "8462",
      "nguon": "nhom8463.nhom",
      "trich": "Với sự loại trừ của các loại máy công cụ của nhóm 84.62",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Bộ phận và phụ tùng của máy công cụ",
      "sangNhom": "8466",
      "nguon": "nhom8463.nhom",
      "trich": "các bộ phận và phụ tùng (trừ các dụng cụ thuộc Chương 82) của các loại máy công cụ thuộc nhóm này được xếp vào nhóm 84.66.",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Dụng cụ thao tác bằng tay hoạt động bằng khí nén, thủy lực hoặc gắn động cơ",
      "sangNhom": "8467",
      "nguon": "nhom8463.nhom",
      "trich": "(d) Dụng cụ thao tác bằng tay hoạt động bằng khí nén, thủy lực hoặc gắn động cơ dùng hoặc không dùng điện (nhóm 84.67).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Máy móc để bện dây thừng, cáp tao bằng dây kim loại",
      "sangNhom": "8479",
      "nguon": "nhom8463.nhom",
