{
 "nhom": "2812",
 "phamVi": {
  "text": "Các dạng clorua của phi kim loại; oxit clorua của phi kim loại; halogenua khác và oxit halogenua khác của phi kim loại.",
  "nguon": "nhom2812.nhom",
  "trich": "(A) CÁC DẠNG CLORUA CỦA PHI KIM LOẠI … (B) OXIT CLORUA CỦA PHI KIM LOẠI … (C) HALOGENUA KHÁC VÀ OXIT HALOGENUA KHÁC CỦA PHI KIM LOẠI",
  "nguonLoai": "NGUOI_DUYET"
 },
 "dieuKienVao": [],
 "loaiTru": [
  {
   "dieuKien": "phosphonium chloride (PH4Cl)",
   "sangNhom": "2853",
   "nguon": "nhom2812.nhom",
   "trich": "Phosphonium chloride (PH4Cl) bị loại trừ (nhóm 28.53).",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "dieuKien": "các sản phẩm thay thế của hydro silicides",
   "sangNhom": "2853",
   "nguon": "nhom2812.nhom",
   "trich": "Các sản phẩm thay thế của hydro silicides như trichlorosilane (SiHCl3) bị loại trừ (nhóm 28.53).",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "dieuKien": "cacbon tetra clorua, hexachloroethane, hexachlorobenzene, octachloronaphthalene và các dạng cacbon clorua tương tự, là các dẫn xuất clo hóa của hydrocarbon",
   "sangNhom": "2903",
   "nguon": "nhom2812.nhom",
   "trich": "Nhóm này không bao gồm cacbon tetra clorua (tetrachloruamenthane (CCl4) hexachloroethane (carbon hexachloride) (C2Cl6), hexachlorobenzene (ISO) (C6Cl6), octachloronaphthalene (C10Cl8) và các dạng cacbon clorua tương tự; đây là các dẫn xuất clo hóa của hydrocarbon (nhóm 29.03)",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "dieuKien": "axit chlorosulphuric",
   "sangNhom": "2806",
   "nguon": "nhom2812.nhom",
   "trich": "Nhóm này không bao gồm axit chlorosulphuric (“sulphuric chlorohydrin”) (ClSO2.OH) (nhóm 28.06).",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "dieuKien": "phospho bromua (PH4Br) và carbon bromua",
   "sangNhom": "2853|2903",
   "nguon": "nhom2812.nhom",
   "trich": "Nhóm này không bao gồm phospho bromua (PH4Br) (nhóm 28.53) và carbon bromua (nhóm 29.03).",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "dieuKien": "cacbon clorua oxit hòa tan trong benzen, dung dịch rượu của amoniac và dung dịch keo của hydroxit nhóm",
   "sangNhom": "3824",
   "nguon": "ch28.chuong",
   "trich": "Vì vậy, cacbon clorua oxit được hòa tan trong benzen, dung dịch rượu của amoniac và dung dịch keo của hydroxit nhóm bị loại trừ khỏi Chương này và được phân loại vào nhóm 38.24.",
   "nguonLoai": "NGUOI_DUYET"
  }
 ],
 "phanBiet": [
  {
   "hoi": "Hàng này có được hòa tan trong toluen hoặc benzen không?",
   "neuCo": "3824",
   "neuKhong": "2812",
   "nguon": "nhom2812.nhom",
   "trich": "(5) Carbonyl diclorua (phosgene, carbon clorua oxit, carbonyl clorua) (COCl2). … Khi hòa tan trong toluen hoặc benzen, nó được phân loại vào nhóm 38.24.",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "hoi": "Hàng này là bo triflorua (BF3) tạo phức với các hợp chất hữu cơ không?",
   "neuCo": "2942",
   "neuKhong": "2812",
   "nguon": "nhom2812.nhom",
   "trich": "(c) Bo triflorua (BF3). … Nó tạo phức với các hợp chất hữu cơ (ví dụ, dietyl ete, axit axetic hoặc phenol); các hợp chất này, cũng được sử dụng làm chất xúc tác, và được phân loại vào nhóm 29.42.",
   "nguonLoai": "NGUOI_DUYET"
  },
  {
   "hoi": "Hàng này là photpho iodua (PH4I) không?",
   "neuCo": "2853",
   "neuKhong": "2812",
   "nguon": "nhom2812.nhom",
   "trich": "Photpho iodua (PH4I) được phân loại vào nhóm 28.53.",
   "nguonLoai": "NGUOI_DUYET"
  }
 ],
