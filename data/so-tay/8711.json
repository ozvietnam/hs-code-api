{
  "nhom": "8711",
  "phamVi": {
    "text": "Mô tô (kể cả moped) và xe đạp có gắn động cơ phụ trợ, có hoặc không có thùng xe bên cạnh; thùng xe có bánh (side-cars).",
    "nguon": "nhom8711.nhom",
    "trich": "Nhóm này bao gồm nhóm những xe môtô hai bánh được thiết kế chủ yếu để chở người. Ngoài các xe mô tô thông thường, Nhóm này bao gồm cả các xe tay ga, có đặc điểm là bánh xe cỡ nhỏ và một sàn nằm ngang nối phần trước và phần sau xe; xe gắn máy có bàn đạp được trang bị cả động cơ và hệ thống bàn đạp chân; và xe đạp có lắp động cơ phụ trợ.",
    "nguonLoai": "AI_DA_KIEM"
  },
  "dieuKienVao": [
