      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Chế phẩm dùng làm dầu cắt nhưng không thích hợp sử dụng trực tiếp",
      "sangNhom": "3402",
      "nguon": "nhom3403.nhom",
      "trich": "Các chế phẩm (ví dụ, các chế phẩm với thành phần cơ bản là sulphonat dầu mỏ hoặc các sản phẩm hoạt động bề mặt khác) dùng để làm dầu cắt, nhưng thường không thích hợp với việc sử dụng trực tiếp như dầu cắt thì không bao gồm trong phần này (nhóm 34.02).",
      "nguonLoai": "AI_DA_KIEM"
    },
    {
      "dieuKien": "Chế phẩm tách khuôn ăn được dùng cho hiệu bánh mì",
      "sangNhom": "1517",
      "nguon": "nhom3403.nhom",
      "trich": "(Tuy nhiên, nhóm này loại trừ các hỗn hợp hoặc chế phẩm ăn được của mỡ hoặc dầu động vật hoặc thực vật thuộc loại dùng như các chế phẩm dùng để tách khuôn (ví dụ, dầu tách khuôn dùng trong hiệu bánh mỳ) (nhóm 15.17).",
      "nguonLoai": "AI_DA_KIEM"
    },
