      "value": true,
      "donVi": null,
      "ngoaiTru": [],
      "nguon": "nhom3403.nhom",
      "trich": "Với điều kiện là các chất này không chứa từ 70% dầu có nguồn gốc từ dầu mỏ hoặc dầu từ khoáng chất bitum như thành phần cơ bản (xem nhóm 27.10)",
      "nguonLoai": "AI_DA_KIEM"
    }
  ],
  "loaiTru": [
    {
      "dieuKien": "Chế phẩm chứa từ 70% trở lên dầu mỏ hoặc dầu bitum",
