{
  "nhom": "3403",
  "phamVi": {
    "text": "Các chế phẩm bôi trơn, chế phẩm chống gỉ hoặc chống mài mòn và chế phẩm tách khuôn đúc chứa dưới 70% trọng lượng dầu mỏ hoặc dầu từ khoáng bitum.",
    "nguon": "nhom3403.nhom",
    "trich": "Với điều kiện là các chất này không chứa từ 70% dầu có nguồn gốc từ dầu mỏ hoặc dầu từ khoáng chất bitum như thành phần cơ bản (xem nhóm 27.10), ngoài những đề cập khác, nhóm này bao gồm hỗn hợp đã điều chế của các loại dưới đây: (A) Các chế phẩm bôi trơn được chế tạo để giảm ma sát giữa các bộ phận chuyển động trong máy móc, xe cộ, máy bay hoặc các thiết bị, dụng cụ hoặc công cụ.",
    "nguonLoai": "AI_DA_KIEM"
  },
  "dieuKienVao": [
    {
      "fact": "la_che_pham_boi_tron_hoac_tach_khuon_chua_duoi_70_phan_tram_dau_mo",
