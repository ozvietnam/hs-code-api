  "ghiChuSoan": [
    {
      "ma": "984934~r19711",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.984934~r19711 \"Bộ phận và phụ kiện khác của thân xe (kể cả ca-bin)\" — \"khác\" là phần còn lại của thân xe so với anh em r19709 (thanh chắn) ⇒ phanConLai mảng [\"984934~r19709\"]; \"(kể cả ca-bin)\" là vế kể cả (PHU); vế \"của thân xe\" ⇒ dungCho"
    },
    {
      "ma": "984934~r19709",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.984934~r19709 \"(ba đờ xốc)\" là ngoặc chú thích ⇒ không thành điều kiện; vế MỞ \"và bộ phận của nó\" ⇒ HOAC [[tenLoai \"Thanh chắn chống va đập\"], [laBoPhan CO, dungCho \"Thanh chắn chống va đập\"]]"
    },
    {
      "ma": "98493416",
      "loai": "QUYET_DINH",
      "ghiChu": "tax.98493416 \"xe khác thuộc nhóm 87.04\" — \"khác\" là định ngữ của đích (xe khác ngoài phân nhóm 8704.10 đã có dòng 98493415), không phải phần còn lại so với anh em ⇒ phanConLai: false"
    },
    {
      "ma": "98493476",
      "loai": "BO_VE",
      "ve": "(trừ phân nhóm 8704.10)",
      "lyDo": "vế trừ dẫn phân nhóm 8704.10: hàng dùng cho xe 8704.10 đã có dòng riêng 98493472 dưới cùng cây (r19771 → 98493472); tu-vung@2 không có op phủ định theo mã cho dungCho — bỏ vế không làm hàng 8704.10 rơi nhầm vì đã được dòng anh em trong cùng cụm nhận"
    },
    {
      "ma": "98493479",
      "loai": "QUYET_DINH",
      "ghiChu": "tax.98493479 vế \"có khối lượng toàn bộ theo thiết kế trên 45 tấn\" ⇒ khoiLuongToanBo > 45 tấn; vế \"Dùng cho xe tự đổ\" ⇒ dungCho \"xe tự đổ\""
    },
    {
      "ma": "98493479",
      "loai": "BO_VE",
      "ve": "để sử dụng trên các loại đường không phải đường quốc lộ",
      "lyDo": "vế nêu môi trường hoạt động của xe tự đổ (off-road) — tu-vung@2 không có khoá đọc loại đường; ranh giới chính của dòng là đích \"xe tự đổ\" + khối lượng > 45 tấn đã phủ; hàng tự đổ dưới 45 tấn hoặc dùng đường quốc lộ rơi về 98493480/98493481"
    },
    {
      "ma": "984934~r19775",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.984934~r19775 \"Bánh xe đã được lắp lốp\" — tu-vung@2 không có khoá riêng cho \"lắp lốp\" nên giữ tenLoai trọn cụm nguyên văn (chứa vế \"được lắp lốp\"), tương tự r19779 với \"chưa được lắp lốp\" — hai giá trị rời nhau"
    },
    {
      "ma": "984934~r19752",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.984934~r19752 \"Cầu chủ động có vi sai, có hoặc không kèm theo chi tiết khác của cụm hộp số, và các cầu bị động; các bộ phận của chúng\" — \"có hoặc không kèm theo\" là dạng không bắt buộc (máy không đòi); tên hai hàng (cầu chủ động có vi sai / cầu bị động) ⇒ mảng, giá trị 1 chứa vế \"có vi sai\""
    },
    {
      "ma": "984934~r19713",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.984934~r19713 \"Loại khác\" trần ⇒ không điều kiện (máy phủ định anh em 98493412, r19714)"
    },
    {
