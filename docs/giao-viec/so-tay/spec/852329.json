  "ghiChuSoan": [
    {"ma": "852329~r15471", "loai": "QUYET_DINH", "ghiChu": "tieuDe.r15471 \"Băng từ, có chiều rộng không quá 4 mm\" ⇒ tenLoai \"Băng từ\" + chieuRong <= 4 mm; r15478 \"trên 4 mm nhưng không quá 6,5 mm\" ⇒ > 4 và <= 6,5; r15488 \"trên 6,5 mm\" ⇒ > 6,5; r15498 \"Đĩa từ\" ⇒ tenLoai \"Đĩa từ\""},
    {"ma": "8523291", "loai": "QUYET_DINH", "ghiChu": "tieuDe.8523291/8523293/8523295/8523297/852329~r15511 \"Loại chưa ghi\" ⇒ daGhi KHONG (đọc \"chưa ghi\")"},
    {"ma": "85232942", "loai": "QUYET_DINH", "ghiChu": "tax.85232942/.62/.86 \"Loại dùng cho điện ảnh\" ⇒ dungCho \"điện ảnh\""},
    {"ma": "85232943", "loai": "QUYET_DINH", "ghiChu": "tax.85232943/.63 \"Băng video khác\" ⇒ tenLoai \"Băng video\" + phanConLai: true (phần còn lại có tên trong tầng — .42 dùng cho điện ảnh đứng trước)"},
    {"ma": "85232971", "loai": "QUYET_DINH", "ghiChu": "tax.85232971 \"Đĩa cứng và đĩa mềm máy vi tính\" ⇒ tenLoai mảng [Đĩa cứng, đĩa mềm] (\"máy vi tính\" là định ngữ chung) + dungCho \"máy vi tính\""},
    {"ma": "85232981", "loai": "QUYET_DINH", "ghiChu": "tax.85232981/.91/.93 \"Loại dùng cho máy vi tính\" ⇒ dungCho \"máy vi tính\""},
    {"ma": "852329~r15503", "loai": "QUYET_DINH", "ghiChu": "tieuDe.r15503/r15515 \"Loại để tái tạo các hiện tượng trừ âm thanh hoặc hình ảnh\" ⇒ congDung \"tái tạo các hiện tượng\" (vế loại trừ \"trừ âm thanh hoặc hình ảnh\" không có op phủ định — như 07119050, nhưng đây là tầng phân nhóm chính giữa các dòng đã định nghĩa theo máy vi tính/Loại khác nên ghi phần khẳng định được)"},
    {"ma": "85232961", "loai": "THIEU_KHOA_TU_VUNG", "khoaDeXuat": "duLieuMayDocDuoc", "ghiChu": "tax.85232961 \"Loại sử dụng để tái tạo các tập lệnh, dữ liệu… ghi ở dạng mã nhị phân để máy có thể đọc được, và có thể thao tác hoặc có thể tương tác… thông qua một máy xử lý dữ liệu tự động; phương tiện lưu trữ được định dạng riêng (đã ghi)\" — không có khoá cho dữ liệu nhị phân máy đọc được / phương tiện định dạng riêng"},
    {"ma": "85232983", "loai": "THIEU_KHOA_TU_VUNG", "khoaDeXuat": "duLieuMayDocDuoc", "ghiChu": "tax.85232983 \"Loại khác, loại sử dụng để tái tạo các tập lệnh… mã nhị phân…\" — như .61, thiếu khoá"},
    {"ma": "85232985", "loai": "THIEU_KHOA_TU_VUNG", "khoaDeXuat": "noiDungPhim", "ghiChu": "tax.85232985 \"Loại khác, chứa phim điện ảnh trừ phim thời sự, phim du lịch, phim kỹ thuật, phim khoa học, và phim tài liệu khác\" — vế loại trừ danh sách phim không có op phủ định cho liệt kê (như 07119050)"},
    {"ma": "85232995", "loai": "THIEU_KHOA_TU_VUNG", "khoaDeXuat": "duLieuMayDocDuoc", "ghiChu": "tax.85232995 \"Loại khác, loại sử dụng để tái tạo các tập lệnh…\" — như .61"},
    {"ma": "85232919", "loai": "QUYET_DINH", "ghiChu": "Các dòng \"Loại khác\" trần (.19/.29/.39/.49/.59/.69/.79/.82/.89/.92/.94/.99) ⇒ không điều kiện (máy phủ định anh em)"}
