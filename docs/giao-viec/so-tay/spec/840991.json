  "ghiChuSoan": [
    {
      "ma": "8409911",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409911 \"Dùng cho máy thuộc nhóm 84.29 hoặc 84.30\" ⇒ dungCho [\"84.29\",\"84.30\"]; .912 \"Dùng cho xe thuộc nhóm 87.01\" ⇒ dungCho \"87.01\"; .913 \"Dùng cho xe của nhóm 87.11\" ⇒ dungCho \"87.11\"; r12982 \"Dùng cho tàu thuyền thuộc Chương 89\" ⇒ dungCho \"Chương 89\". Anh em cùng tầng đều dùng dungCho."
    },
    {
      "ma": "8409914",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409914 \"Dùng cho xe khác thuộc Chương 87\" ⇒ dungCho \"Chương 87\" + phanConLai: true (\"xe khác\" = trừ 87.01, 87.11 đứng trước; LUAT-CHUNG: nhóm 87.xx thoả \"Chương 87\")."
    },
    {
      "ma": "8409917",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409917 \"Dùng cho động cơ khác\" ⇒ dungCho \"động cơ\" + phanConLai: true (phủ định mọi tầng anh em đứng trước)."
    },
    {
      "ma": "8409915",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409915 \"Cho động cơ máy thủy công suất không quá 22,38 kW\" ⇒ congSuat <= 22.38 kW; .916 \"… trên 22,38 kW\" ⇒ congSuat > 22.38 kW. Công suất là của động cơ máy thủy mà bộ phận dùng cho (chữ tiêu đề), không phải của bộ phận — người soát lưu ý khi hỏi dữ kiện."
    },
    {
      "ma": "84099113",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Ống xi lanh, có đường kính trong từ 50 mm trở lên, nhưng không quá 155 mm\" ⇒ tenLoai \"Ống xi lanh\" + duongKinhTrong >= 50 mm + duongKinhTrong <= 155 mm (\"từ … trở lên\" = >=, \"không quá\" = <=); áp cho .13/.23/.43/.52/.62/.73. \"Ống xi lanh khác\" ⇒ tenLoai \"Ống xi lanh\" + phanConLai: true."
    },
    {
      "ma": "84099116",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Piston, có đường kính ngoài từ 50 mm trở lên, nhưng không quá 155 mm\" ⇒ tenLoai \"Piston\" + duongKinh (đường kính ngoài) >= 50 mm + <= 155 mm; áp cho .16/.26/.46/.54/.64/.76. \"Piston khác\" ⇒ tenLoai \"Piston\" + phanConLai: true. \"Bạc piston và chốt piston\" ⇒ tenLoai [\"Bạc piston\",\"chốt piston\"] (tên cụ thể hơn \"Piston\")."
    },
    {
      "ma": "84099111",
      "loai": "DE_TRONG",
      "ghiChu": "\"Chế hòa khí và bộ phận của chúng\" ⇒ tenLoai \"Chế hòa khí\"; vế \"và bộ phận của chúng\" không có khoá riêng (laBoPhan là có/không chung, không nói bộ phận CỦA chế hòa khí) — bộ phận chế hòa khí được nhận khi mô tả hàng có chữ \"chế hòa khí\". Áp cho .11/.21/.31/.41/.71."
    },
    {
      "ma": "84099112",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Thân động cơ (cylinder block); hộp trục khuỷu\" ⇒ tenLoai [\"Thân động cơ\",\"hộp trục khuỷu\"]; \"Quy lát và nắp quy lát\" ⇒ tenLoai [\"Quy lát\",\"nắp quy lát\"]."
    },
    {
      "ma": "84099118",
      "loai": "CHONG_LAN",
      "ghiChu": "ĐỎ có chủ đích: cong2-chong-lan .16+.18 (và .26+.28, .46+.48, .76+.78) do BỘ SO CHỮ — \"Bạc piston\" chứa chuỗi \"Piston\" của dòng .x6 \"Piston, có đường kính ngoài từ 50 mm trở lên, nhưng không quá 155 mm\"; tenCuTheHon không áp vì dòng .x6 còn ràng buộc duongKinh. Chữ biểu KHÔNG tự chồng (bạc/chốt piston không phải piston) nên không khai chongLanVanBan; .18 không có chữ \"khác\" nên không dùng phanConLai. Cần sửa công cụ (tenCuTheHon khi bên chung còn ràng buộc khoá khác) — không ép."
    },
    {
      "ma": "84099113",
      "loai": "QUYET_DINH",
      "ghiChu": "cong3-bien-khong-doc-duoc trên mọi dòng ống xi lanh/piston có ngưỡng: đã đối chiếu tay — \"từ 50 mm trở lên\" = >= 50 mm, \"nhưng không quá 155 mm\" = <= 155 mm."
    }
  ]
}
