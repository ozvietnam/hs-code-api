  "ghiChuSoan": [
    {
      "ma": "8409911",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409911 \"Dùng cho máy thuộc nhóm 84.29 hoặc 84.30\" ⇒ dungCho [\"84.29\",\"84.30\"]; .912 \"Dùng cho xe thuộc nhóm 87.01\" ⇒ dungCho \"87.01\"; .913 \"Dùng cho xe của nhóm 87.11\" ⇒ dungCho \"87.11\"; r12982 \"Dùng cho tàu thuyền thuộc Chương 89\" ⇒ dungCho \"Chương 89\". Anh em cùng tầng đều dùng dungCho."
    },
    {
      "ma": "8409914",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409914 \"Dùng cho xe khác thuộc Chương 87\" ⇒ dungCho \"Chương 87\" + phanConLai: true (\"xe khác\" = trừ 87.01, 87.11 đứng trước; LUAT-CHUNG: nhóm 87.xx thoả \"Chương 87\")."
    },
    {
      "ma": "8409917",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409917 \"Dùng cho động cơ khác\" (EN \"For other engines\") ⇒ phanConLai: true đứng một mình, dieuKienSo [] (#653, cùng dạng 850110~r14839): cả phân nhóm 840991 là bộ phận \"Chỉ dùng hoặc chủ yếu dùng cho động cơ đốt trong …\" nên \"dùng cho động cơ\" lặp ý phân nhóm, nội dung thật chỉ là phủ định các tầng anh em đứng trước. Trước đây ghi dungCho \"động cơ\" + phanConLai: hẹp hơn chữ khi mô tả bộ phận không nhắc chữ \"động cơ\" (lộ ra khi .71 có phương án dungCho \"Chế hòa khí\" — cong1-khong-phu-kin tầng gốc)."
    },
    {
      "ma": "8409915",
      "loai": "QUYET_DINH",
      "ghiChu": "tieuDe.8409915 \"Cho động cơ máy thủy công suất không quá 22,38 kW\" ⇒ dungCho \"động cơ máy thủy\" + congSuat <= 22.38 kW; .916 \"Cho động cơ máy thủy công suất trên 22,38 kW\" ⇒ dungCho \"động cơ máy thủy\" + congSuat > 22.38 kW (bổ sung #661: vế \"Cho động cơ máy thủy\" là giới hạn — bộ phận cho động cơ phụ của tàu không phải động cơ máy thủy). Công suất là của động cơ máy thủy mà bộ phận dùng cho (chữ tiêu đề), không phải của bộ phận."
    },
    {
      "ma": "84099113",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Ống xi lanh, có đường kính trong từ 50 mm trở lên, nhưng không quá 155 mm\" ⇒ tenLoai \"Ống xi lanh\" + duongKinhTrong >= 50 mm + duongKinhTrong <= 155 mm (\"từ … trở lên\" = >=, \"không quá\" = <=); áp cho .13/.23/.43/.52/.62/.73. \"Ống xi lanh khác\" ⇒ tenLoai \"Ống xi lanh\" + phanConLai: true."
    },
    {
      "ma": "84099116",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Piston, có đường kính ngoài từ 50 mm trở lên, nhưng không quá 155 mm\" ⇒ tenLoai \"Piston\" + duongKinh (đường kính ngoài) >= 50 mm + <= 155 mm; áp cho .16/.26/.46/.54/.64/.76. \"Piston khác\" ⇒ tenLoai \"Piston\" + phanConLai: true. \"Bạc piston và chốt piston\" ⇒ tenLoai [\"Bạc piston\",\"chốt piston\"] (tên cụ thể hơn \"Piston\")."
    },
    {
      "ma": "84099111",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Chế hòa khí và bộ phận của chúng\" là vế MỞ \"X và bộ phận của chúng\" ⇒ HOAC [[tenLoai \"Chế hòa khí\"], [laBoPhan CO, dungCho \"Chế hòa khí\"]] (QUY-TRINH 3.11, trả về #661: TEN_LOAI đọc danh từ đầu nên \"Kim phao của chế hòa khí\" không thoả tenLoai). X chép nguyên văn tên đầu của chính dòng. Áp cho .11/.21/.31/.41/.71."
    },
    {
      "ma": "84099112",
      "loai": "QUYET_DINH",
      "ghiChu": "\"Thân động cơ (cylinder block); hộp trục khuỷu\" ⇒ tenLoai [\"Thân động cơ\",\"hộp trục khuỷu\"]; \"Quy lát và nắp quy lát\" ⇒ tenLoai [\"Quy lát\",\"nắp quy lát\"]."
    },
    {
      "ma": "84099118",
      "loai": "QUYET_DINH",
