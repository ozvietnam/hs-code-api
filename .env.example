# Copy to .env (gitignored). Never commit real keys.
#   cp .env.example .env

HS_API_TOKEN=
HS_ADMIN_TOKEN=

# Gemini MIỄN PHÍ: chỉ là dự phòng khi MiniMax/Hermes lỗi (xoay vòng, cách nhau dấu phẩy). Để trống được.
GEMINI_FREE_KEYS=
# Gemini TRẢ PHÍ: chỉ dùng cho tier "premium" hoặc khi không có nhà cung cấp nào khác.
GEMINI_API_KEY=

# DỮ LIỆU KHÁCH (#237 J1): lượt từ khoá dịch vụ (Cổng OZ, ERP) chỉ đi nhà cung cấp trong danh sách trắng này —
# không bao giờ qua GEMINI_FREE_KEYS, mẫu OpenRouter ":free" hay Hermes (chưa xác minh nhà cung cấp phía sau).
# Hết nhà cung cấp hợp lệ → lỗi NO_PRIVATE_LLM, không rơi xuống tầng miễn phí. "gemini" = khoá trả phí GEMINI_API_KEY.
LLM_NO_TRAIN_PROVIDERS=minimax,gemini
# true → MỌI lượt (kể cả công khai, HS_API_TOKEN, script batch) coi là dữ liệu khách.
HS_LLM_PRIVATE_ALL=
GEMINI_RERANK_MODEL=gemini-2.5-flash
GEMINI_DESCRIBE_MODEL=gemini-2.5-flash
GEMINI_ENRICH_MODEL=gemini-2.5-flash

# Hermes Pool — cổng AI dùng chung (LiteLLM proxy, chuẩn OpenAI).
# Nhóm key theo dự án; dự án này = key-hs-knowledge. base_url + key thật lấy từ tài liệu bàn giao AXIT.
# KHÔNG điền IP/key thật vào file này (repo public). Ưu tiên #1 cho batch enrich + runtime fallback.
HERMES_BASE_URL=
HERMES_API_KEY=
# Tên model trên cổng Hermes (thiếu thì đọc HERMES_MODEL, rồi mới tới 'deepseek-chat').
# 'deepseek-chat' = model NHANH (DeepSeek Direct trả phí, đã nạp); 'reasoning' cũ chậm "im 7 phút" (#240.4).
HERMES_ENRICH_MODEL=deepseek-chat

# Nhà cung cấp CHÍNH (gói MiniMax trả phí, gọi thẳng). Bản highspeed ~100 token/giây;
# gói không cho dùng thì tự lùi về MINIMAX_FALLBACK_MODEL.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_FALLBACK_MODEL=MiniMax-M2.7

# #425 — Timeout theo BƯỚC (ms) + ngắt mạch theo (provider, bước). Không đặt = hành vi cũ.
# Tên bước = opts.step của caller: engine-loop vòng 1 'UNDERSTAND', vòng 2 'GIR'; describe 'DESCRIBE'; suggest 'SUGGEST'.
# Giá trị là TRẦN: không vượt ngân sách vòng (LOOP_R1_TIMEOUT_MS / LOOP_R2_TIMEOUT_MS = 100000 / 160000).
# #725 lỗi 45 (02/11/2026): khi MiniMax là nhà cung cấp hợp lệ DUY NHẤT (Gemini trả phí 402) thì KHÔNG đặt hai biến bước dưới
# 75000 / 110000 — MiniMax có suy luận: một lời gọi describe ~30 s, vòng 1 đo 20–74 s, vòng 2 70–107 s (25–26/10). Đề xuất
# cũ "30000 / 90000" cắt gần như mọi lượt vòng 1. Khuyến nghị: để trống (dùng 100000 / 160000 của engine-loop).
LLM_TIMEOUT_MS_UNDERSTAND=
LLM_TIMEOUT_MS_GIR=
LLM_TIMEOUT_MS_DEFAULT=
# Sau N timeout liên tiếp của một (provider, bước) → bỏ qua provider đó cho bước đó trong NGHI_MS, không chờ timeout nữa.
# Xem mạch đang mở ở /api/health → checks.llm.ngatMach. Mặc định 2 lỗi / 300000 ms (5 phút).
LLM_NGAT_MACH_LOI_LIEN_TIEP=
LLM_NGAT_MACH_NGHI_MS=
# #725-45: khoá Gemini trả phí trả 402 (hết tiền nạp) / 401 / 403 → bỏ qua Gemini ở MỌI bước trong khoảng này (mặc định 900000 =
# 15 phút), rồi dò lại một lần. /api/health → checks.llm.ngatMach có mục {provider:'gemini', step:'*', lyDo:'THANH_TOAN'}.
LLM_NGAT_MACH_THANH_TOAN_MS=
# #725-45: trần lần gọi lại "tắt suy nghĩ" của engine-loop (lưới an toàn khi JSON cụt / quá giờ). Mặc định 45000 (tạm, = 1,5 × ~30 s
# một lời gọi MiniMax-M2.7-highspeed); luôn bị chặn thêm bởi hạn chót lượt CLASSIFY_BUDGET_MS. Giá trị cũ (#425): 30000.
LOOP_THINKING_OFF_TIMEOUT_MS=

OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_ENRICH_MODEL=gemma4:31b

# OpenRouter — free models + fallback (docs/openrouter.md)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://your-app.vercel.app
OPENROUTER_APP_NAME=hs-code-api
